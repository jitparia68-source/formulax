# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is committed on purpose: it documents which variables the app needs
# without containing any values. A later pattern would not override the .env* above.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# product requirement doc: working reference only
prd.md

# scratch prototypes consumed during development
ui_ref/

# test artifacts (unit tests are run from a scratch location, not committed)
coverage/
test-results/
playwright-report/
