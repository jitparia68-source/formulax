# Supabase Postgres, provisioned via the Vercel Supabase marketplace.
# Application traffic uses the service-role client, which bypasses RLS.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk. Both keys are required; there is no working default for either.
# Development instances use pk_test_/sk_test_ and are heavily rate limited, so use
# pk_live_/sk_live_ from a production instance before deploying.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk routes. These must be set or auth.protect() sends visitors to Clerk's hosted
# sign-in UI instead of this app's own /login page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
